# Public configuration only. Vite inlines every VITE_-prefixed var into
# the browser bundle at build time — anyone can read these from devtools.
# NEVER put a secret, API key, or credential in this file or any VITE_*
# var. Server-only secrets belong in backend/.env, not here.
#
# Validated at import time in src/shared/config/env.ts — the app throws a
# clear error immediately if one of these is missing.
#
# VITE_WS_URL uses the SAME port as VITE_API_URL, just ws:// instead of
# http://. The backend's WebSocket gateway is @nestjs/websockets (Socket.IO),
# which attaches to the same underlying HTTP server as the REST API by
# default — it does not listen on a separate port. If backend PORT changes,
# update the port here too (both must match).

VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000
