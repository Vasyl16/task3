// Initial domain model for the marketplace. Postgres is the single source
// of truth for everything here (see ../CLAUDE.md and ../../CLAUDE.md).
//
// Scope notes (deliberately NOT modeled yet, to avoid over-engineering
// ahead of need):
// - Single application-wide currency assumed; no per-row currency column.
// - No product variants — Product is the sellable unit directly.
// - No dedicated Payment/gateway-transaction table — LedgerEntry records
//   the fact of a sale/commission/refund/payout abstractly; payment
//   gateway integration is a separate future concern.
// - No CQRS/read-model tables — Meilisearch (outside Postgres) is the
//   only read model, kept eventually consistent via OutboxEvent.
//   Analytics deliberately does NOT add pre-aggregated rollup tables: it
//   sums LedgerEntry/OrderItem live, so a reported figure can never drift
//   from the transactional rows it came from. CartSession is the one
//   reporting-shaped table, and only because checkout DELETES cart items
//   — see its comment; it is still written transactionally, not derived.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===================== Identity & Access =====================

// CUSTOMER is the default for every new account. SELLER is granted (and
// revoked) transactionally by SellersService whenever a SellerProfile
// moves to/from APPROVED — see the sellers module's review flow. Kept as
// a real role (not derived-on-read) so RolesGuard can check it directly
// from the JWT payload without a DB hit; the accepted trade-off is up to
// one access-token lifetime (15m) of staleness after a status change.
enum UserRole {
  CUSTOMER
  SELLER
  ADMIN
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String? // null for Google-OAuth-only accounts
  name         String
  avatarUrl    String?
  role         UserRole @default(CUSTOMER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sellerProfile          SellerProfile?  @relation("SellerProfileOwner")
  sellerProfilesReviewed SellerProfile[] @relation("SellerProfileReviewer")
  productsModerated      Product[]       @relation("ProductModerator")

  refreshTokens RefreshToken[]
  cart          Cart?
  orders        Order[]
  bids          Bid[]
  wonAuctions   Auction[]      @relation("AuctionWinner")
  notifications Notification[]
  reviews       Review[]

  refundsRequested Refund[]  @relation("RefundRequester")
  refundsResolved  Refund[]  @relation("RefundResolver")
  disputesRaised   Dispute[] @relation("DisputeRaiser")
  disputesResolved Dispute[] @relation("DisputeResolver")

  @@index([role])
}

// Refresh tokens are never stored in plaintext — only a SHA-256 hash, so
// a DB leak doesn't hand out usable tokens. Each refresh rotates: the
// presented token is revoked and a new one issued. Presenting an already-
// revoked token is treated as a signal of theft (see AuthService.refresh).
model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

enum SellerProfileStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model SellerProfile {
  id           String              @id @default(uuid())
  userId       String              @unique
  user         User                @relation("SellerProfileOwner", fields: [userId], references: [id], onDelete: Restrict)
  businessName String
  description  String?
  status       SellerProfileStatus @default(PENDING)

  reviewedByUserId String?
  reviewedByUser   User?     @relation("SellerProfileReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  reviewedAt       DateTime?

  appliedAt DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products      Product[]
  auctions      Auction[]
  sellerOrders  SellerOrder[]
  ledgerEntries LedgerEntry[]
  reviews       Review[]

  @@index([status])
}

// ===================== Catalog =====================

model Category {
  id        String     @id @default(uuid())
  name      String     @unique
  slug      String     @unique
  parentId  String?
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryHierarchy")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  products Product[]

  @@index([parentId])
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// AUCTION products are sold only via the bidding flow (see Auction) —
// BiddingService rejects creating an auction for a FIXED_PRICE product,
// and CartService rejects adding an AUCTION product to a cart.
enum ProductType {
  FIXED_PRICE
  AUCTION
}

model Product {
  id          String        @id @default(uuid())
  sellerId    String
  seller      SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  categoryId  String
  category    Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  slug        String        @unique
  description String?
  // A public path served by ServeStaticModule (e.g. "/uploads/products/
  // <uuid>.jpg"), never an absolute filesystem path or external URL —
  // see ProductsController's image upload route. Null until a seller
  // uploads one; the frontend falls back to a generated placeholder.
  imageUrl    String?
  basePrice   Decimal       @db.Decimal(12, 2)
  type        ProductType   @default(FIXED_PRICE)
  status      ProductStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // Reactive moderation audit trail — set only when an ADMIN takes a
  // listing down or reinstates it (see ProductsService.moderate). There
  // is deliberately no pre-publication approval state: nothing in the
  // spec requires sellers to wait for a human before listing, and adding
  // a mandatory review gate would change checkout/search behaviour for
  // every product. status stays the single source of truth for
  // visibility; these three columns only record who/when/why.
  moderatedByUserId String?
  moderatedByUser   User?     @relation("ProductModerator", fields: [moderatedByUserId], references: [id], onDelete: SetNull)
  moderatedAt       DateTime?
  moderationNote    String?

  inventory  Inventory?
  auctions   Auction[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([sellerId])
  @@index([categoryId, status])
}

// Optimistic-locked stock: reservation/decrement during checkout does
// `UPDATE ... WHERE productId = ? AND version = ?`, never a blind write.
model Inventory {
  id                String   @id @default(uuid())
  productId         String   @unique
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantityAvailable Int      @default(0)
  quantityReserved  Int      @default(0)
  version           Int      @default(0)
  updatedAt         DateTime @updatedAt
}

// ===================== Auctions =====================

// ENDED: deadline reached, winner determined (if any bid exists), the
// winner's checkoutDeadline window is open. COMPLETED: winner checked
// out. EXPIRED: either no bids were ever placed, or the winner didn't
// check out within the window — see BiddingService.endAuction /
// expireCheckoutWindowIfUnclaimed.
enum AuctionStatus {
  SCHEDULED
  ACTIVE
  ENDED
  COMPLETED
  EXPIRED
  CANCELLED
}

// version is the optimistic-concurrency guard for bid placement: a bid is
// only accepted by `UPDATE ... WHERE id = ? AND version = ?`, so two
// concurrent bids can never both "win" a race.
model Auction {
  id        String        @id @default(uuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  sellerId  String
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)

  startingPrice   Decimal @db.Decimal(12, 2)
  // Minimum amount a new bid must exceed the current highest bid by (or
  // the starting price, for the first bid) — see
  // BiddingService.computeMinAcceptableBid.
  minBidIncrement Decimal @db.Decimal(12, 2)
  // How many units this auction is for — awarded as one lot to the
  // single winning bidder (never split across multiple winners). Validated
  // at creation against the product's currently-uncommitted stock (available
  // minus what's already committed to this product's other ACTIVE/SCHEDULED
  // auctions — see BiddingService.createAuction), so the sum auctioned can
  // never exceed what's actually in stock. Consumed 1:1 by
  // OrdersService.checkoutAuctionWin's stock decrement on checkout.
  quantity        Int     @default(1)

  // Denormalized current-winner cache, updated transactionally with each
  // accepted bid — avoids a join for the common "show current price" read.
  currentHighestBid      Decimal? @db.Decimal(12, 2)
  currentHighestBidderId String?
  currentHighestBidder   User?    @relation("AuctionWinner", fields: [currentHighestBidderId], references: [id], onDelete: SetNull)

  status           AuctionStatus @default(SCHEDULED)
  version          Int           @default(0)
  startsAt         DateTime
  endsAt           DateTime
  // Set when the auction ENDS with a winner — the winner must complete
  // checkout by this time or the auction is EXPIRED instead (both
  // transitions driven by delayed BullMQ jobs scheduled at auction
  // creation — see AuctionDeadlineConsumer).
  checkoutDeadline DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  bids Bid[]

  @@index([status, endsAt])
  @@index([productId])
  @@index([sellerId])
}

// Immutable append-only ledger — no status field. The winning bid is
// always the one matching Auction.currentHighestBidderId/currentHighestBid;
// duplicating "winning" state here would be a second source of truth.
model Bid {
  id        String   @id @default(uuid())
  auctionId String
  auction   Auction  @relation(fields: [auctionId], references: [id], onDelete: Restrict)
  bidderId  String
  bidder    User     @relation(fields: [bidderId], references: [id], onDelete: Restrict)
  amount    Decimal  @db.Decimal(12, 2)
  placedAt  DateTime @default(now())

  @@index([auctionId, amount(sort: Desc)])
  @@index([auctionId, placedAt])
  @@index([bidderId])
}

// ===================== Cart =====================

model Cart {
  id        String   @id @default(uuid())
  buyerId   String   @unique
  buyer     User     @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items    CartItem[]
  sessions CartSession[]
}

// The cart→order conversion funnel. CartItem rows are DELETED at checkout
// (see CartRepository.clearCart), so a converted cart leaves no trace in
// CartItem — measuring conversion from CartItem.addedAt would count only
// the carts that DIDN'T convert. This table is the durable record.
//
// One row per cart "session": the window from the moment an item lands in
// an empty cart until that cart is checked out (or never). Written inside
// the SAME transaction as the cart mutation / checkout it records, so it
// is transactional Postgres truth, NOT an eventually-consistent
// projection — nothing here is derived asynchronously, and no financial
// figure is read from it.
//
// Known imprecision: two genuinely concurrent "add to empty cart" calls
// from one buyer can open two sessions. Both are then closed together at
// checkout, so numerator and denominator move as a pair and the ratio
// stays sane. Not worth a lock on an analytics funnel counter.
model CartSession {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  buyerId   String
  startedAt DateTime @default(now())

  // Null until this session converts. orderId is not a relation — the
  // funnel record must survive independently of order retention.
  orderId     String?
  convertedAt DateTime?

  // Supports "find this cart's open session" (the hot path, on every
  // add-to-cart) and the period-bounded cohort query analytics runs.
  @@index([cartId, convertedAt])
  @@index([startedAt])
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  addedAt   DateTime @default(now())

  @@unique([cartId, productId])
  @@index([cartId])
}

// ===================== Orders =====================

// Parent Order status is DERIVED from its SellerOrders — recomputed
// synchronously, in the same transaction as the SellerOrder status change
// that triggers it (see ../CLAUDE.md and
// OrdersService/order-status-aggregation.ts for the exact rules).
enum OrderStatus {
  NEW
  PROCESSING
  PARTIALLY_SHIPPED
  SHIPPED
  COMPLETED
  PARTIALLY_CANCELLED
  CANCELLED
}

model Order {
  id          String      @id @default(uuid())
  buyerId     String
  buyer       User        @relation(fields: [buyerId], references: [id], onDelete: Restrict)
  status      OrderStatus @default(NEW)
  totalAmount Decimal     @db.Decimal(12, 2)
  placedAt    DateTime    @default(now())
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  sellerOrders SellerOrder[]

  @@index([buyerId])
  @@index([status])
  // Every analytics query is period-bounded; without this each one is a
  // full scan of the orders table.
  @@index([placedAt])
}

// Independent per-seller lifecycle — a multi-vendor Order decomposes into
// one SellerOrder per seller, each moving through its own states; the
// parent Order never has its own independently-set status (see
// OrderStatus above). Valid transitions (see
// order-status-transitions.ts): NEW -> PROCESSING -> SHIPPED ->
// COMPLETED, or NEW|PROCESSING -> CANCELLED. REFUNDED is a legacy value
// no longer produced by application logic — a refund is tracked via the
// separate Refund model, not a SellerOrder status — kept only because
// Postgres enums can't remove a value once created.
enum SellerOrderStatus {
  NEW
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

model SellerOrder {
  id          String            @id @default(uuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sellerId    String
  seller      SellerProfile     @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  status      SellerOrderStatus @default(NEW)
  subtotal    Decimal           @db.Decimal(12, 2)
  shippingFee Decimal           @default(0) @db.Decimal(12, 2)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  items         OrderItem[]
  ledgerEntries LedgerEntry[]
  refunds       Refund[]
  review        Review?
  disputes      Dispute[]

  @@index([orderId])
  @@index([sellerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String      @id @default(uuid())
  sellerOrderId String
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity      Int
  // Snapshot at time of purchase — never re-read live Product.basePrice.
  unitPrice     Decimal     @db.Decimal(12, 2)
  createdAt     DateTime    @default(now())

  @@index([sellerOrderId])
  @@index([productId])
}

// ===================== Finance =====================

enum LedgerEntryType {
  SALE
  COMMISSION
  REFUND
  PAYOUT
  ADJUSTMENT
}

// Append-only per-seller money-movement log. amount is signed
// (+credit / -debit); balance is always derived by summing, never stored.
model LedgerEntry {
  id            String          @id @default(uuid())
  sellerId      String
  seller        SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  sellerOrderId String?
  sellerOrder   SellerOrder?    @relation(fields: [sellerOrderId], references: [id], onDelete: SetNull)
  type          LedgerEntryType
  amount        Decimal         @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())

  @@index([sellerId])
  @@index([sellerOrderId])
  @@index([type])
  // The ledger IS the financial read model — every revenue figure in
  // analytics is a period-bounded SUM over it, either across the whole
  // platform (type, createdAt) or for one seller (sellerId, createdAt).
  @@index([type, createdAt])
  @@index([sellerId, createdAt])
}

// REQUESTED is the saga's starting state, PROCESSED and FAILED its two
// terminal ones. FAILED means the payment provider refused the refund
// and every retry is exhausted — the money is still owed to the buyer,
// so it is a state a human has to resolve, NOT a silent dead end (see
// RefundConsumer). APPROVED/REJECTED belong to the separate, manual
// buyer-requested refund flow.
enum RefundStatus {
  REQUESTED
  APPROVED
  REJECTED
  PROCESSED
  FAILED
}

model Refund {
  id            String      @id @default(uuid())
  sellerOrderId String
  sellerOrder   SellerOrder @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  // NULL when the system opened this refund itself, which is what a
  // cancellation does — nobody "requested" it, the saga did. A non-null
  // value means a real person asked for it through the manual flow.
  requestedById String?
  requestedBy   User?       @relation("RefundRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  amount        Decimal     @db.Decimal(12, 2)
  reason        String?
  status        RefundStatus @default(REQUESTED)

  // Payment-provider correlation. gatewayRef is what a real provider
  // hands back (and what makes a retried call idempotent on THEIR side);
  // attempts/failureReason are what an operator needs to understand a
  // FAILED refund without digging through logs.
  gatewayRef    String?
  attempts      Int     @default(0)
  failureReason String?

  resolvedById String?
  resolvedBy   User?     @relation("RefundResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  requestedAt DateTime @default(now())

  @@index([sellerOrderId])
  @@index([status])
}

// ===================== Events & Async Processing =====================

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PUBLISHED
  FAILED
}

// Deliberately NOT foreign-keyed to domain tables — aggregateType/
// aggregateId are plain strings so the outbox stays generic and decoupled
// from whatever schema changes happen to specific entities later.
// Written in the SAME transaction as the domain change it describes.
//
// status lifecycle (see OutboxPublisherService):
//   PENDING -> PROCESSING (claimed by a publisher, SKIP LOCKED) ->
//   PUBLISHED (BullMQ enqueue confirmed) | PENDING (enqueue failed,
//   requeued with backoff via availableAt) | FAILED (attempts exhausted).
// A PROCESSING row whose updatedAt is stale (publisher crashed after
// claiming) is reclaimed by the next poll — never stuck forever.
model OutboxEvent {
  id            String            @id @default(uuid())
  aggregateType String
  aggregateId   String
  eventType     String
  payload       Json
  correlationId String
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  lastError     String?
  // Not eligible for (re)publishing until now >= availableAt — used for
  // exponential backoff between retry attempts.
  availableAt   DateTime          @default(now())
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  processedAt   DateTime?

  processedBy ProcessedEvent[]

  @@index([status, availableAt])
  @@index([correlationId])
  @@index([aggregateType, aggregateId])
}

// The idempotency guard for at-least-once event delivery: a consumer
// inserts (eventId, consumerName) before acting on an event. A unique
// violation means "already handled" — skip, don't reapply side effects.
model ProcessedEvent {
  id           String      @id @default(uuid())
  eventId      String
  event        OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  consumerName String
  processedAt  DateTime    @default(now())

  @@unique([eventId, consumerName])
}

enum IdempotencyKeyStatus {
  PROCESSING
  COMPLETED
}

// API idempotency (distinct from ProcessedEvent above, which is for
// EVENT-consumer idempotency): a client-supplied Idempotency-Key header
// for a command like checkout/refund/bid. The unique (key, userId) is
// the concurrency guard — a second request with the same key fails the
// insert with a unique violation while the first is still PROCESSING,
// rather than racing it. userId is required (not optional): Postgres
// unique indexes treat NULL as distinct from NULL, which would silently
// defeat this guard for anonymous callers — every command this backs
// (checkout/refund/bid) requires authentication anyway, so there's no
// legitimate anonymous case to support.
model IdempotencyKey {
  id             String               @id @default(uuid())
  key            String
  userId         String
  // Hash of the request body/route, so the same key reused for a
  // genuinely different request is rejected instead of silently
  // returning the wrong stored response.
  requestHash    String
  status         IdempotencyKeyStatus @default(PROCESSING)
  responseStatus Int?
  responseBody   Json?
  createdAt      DateTime             @default(now())
  completedAt    DateTime?

  @@unique([key, userId])
}

// ===================== Notifications =====================

// Persisted so the REST API can serve full current state on WebSocket
// reconnect — the WS push is delivery-only, this table is the source of
// truth for "what notifications does this user have."
model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// ===================== Trust & Safety =====================

// Unique per SellerOrder — only a verified (completed) purchase can be
// reviewed, and only once.
model Review {
  id            String        @id @default(uuid())
  sellerOrderId String        @unique
  sellerOrder   SellerOrder   @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  authorId      String
  author        User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  sellerId      String
  seller        SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Restrict)
  rating        Int
  comment       String?
  createdAt     DateTime      @default(now())

  @@index([sellerId])
  @@index([authorId])
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

model Dispute {
  id            String        @id @default(uuid())
  sellerOrderId String
  sellerOrder   SellerOrder   @relation(fields: [sellerOrderId], references: [id], onDelete: Restrict)
  raisedById    String
  raisedBy      User          @relation("DisputeRaiser", fields: [raisedById], references: [id], onDelete: Restrict)
  reason        String
  status        DisputeStatus @default(OPEN)
  resolution    String?

  resolvedById String?
  resolvedBy   User?     @relation("DisputeResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([sellerOrderId])
  @@index([status])
}
