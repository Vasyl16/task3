# Server-only configuration. NEVER expose these to the frontend — this
# whole file stays out of the browser bundle by construction (it's read
# via process.env in Node, not bundled by Vite). See ../CLAUDE.md and
# src/config/env.validation.ts — every var below is validated at startup;
# the app fails fast with a clear error if a REQUIRED one is missing.

# App (all optional — sane defaults in src/config/env.validation.ts)
NODE_ENV=development
# PORT serves both the REST API and the WebSocket gateway (@nestjs/websockets
# / Socket.IO attaches to the same HTTP server, no separate WS port). If you
# change this, update frontend/.env's VITE_API_URL and VITE_WS_URL to match.
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL — REMOTE database, REQUIRED, no default. Never point this at
# a local docker-compose service; provision a real (or hosted dev/staging)
# Postgres instance.
DATABASE_URL=postgresql://user:password@remote-host:5432/marketplace?schema=public

# Redis (BullMQ) — optional, defaults to the docker-compose service below
REDIS_URL=redis://localhost:6379

# Meilisearch — optional, defaults to the docker-compose service below.
# MEILI_MASTER_KEY is also read directly by docker-compose to configure
# the meilisearch container itself (see ../docker-compose.yml) — keep the
# two in sync.
MEILISEARCH_HOST=http://localhost:7700
MEILI_MASTER_KEY=changeme_dev_master_key

# Auth — JWT secrets, REQUIRED (min 16 chars), no default. Expiry strings
# are optional.
JWT_ACCESS_SECRET=changeme_access_secret_please_override
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_refresh_secret_please_override
JWT_REFRESH_EXPIRES_IN=7d

# Auth — Google OAuth, optional placeholders (not wired up yet)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
