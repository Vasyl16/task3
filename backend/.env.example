# App
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# PostgreSQL — REMOTE database. Never point this at a local docker-compose
# service; provision a real (or hosted dev/staging) Postgres instance.
DATABASE_URL=postgresql://user:password@remote-host:5432/marketplace?schema=public

# Redis (BullMQ) — provided by docker-compose in local dev
REDIS_URL=redis://localhost:6379

# Meilisearch — provided by docker-compose in local dev.
# MEILI_MASTER_KEY is also read directly by docker-compose to configure
# the meilisearch container itself (see ../docker-compose.yml).
MEILISEARCH_HOST=http://localhost:7700
MEILI_MASTER_KEY=changeme_dev_master_key

# Auth — JWT
JWT_ACCESS_SECRET=changeme_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=changeme_refresh_secret
JWT_REFRESH_EXPIRES_IN=7d

# Auth — Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
